{
  "kind": "collectionType",
  "collectionName": "sl_holiday_tabs",
  "info": {
    "singularName": "sl-holiday-tab",
    "pluralName": "sl-holiday-tabs",
    "displayName": "SL-Holiday-Tab"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "subtitle": {
      "type": "string"
    },
    "description": {
      "type": "richtext"
    },
    "banner": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "cardData": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::sl-package-list.sl-package-list"
    },
    "metaTags": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "shared.seo",
      "repeatable": true,
      "required": true
    },
    "seoSchema": {
      "type": "blocks",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
