{
  "kind": "collectionType",
  "collectionName": "sl_careers",
  "info": {
    "singularName": "sl-career",
    "pluralName": "sl-careers",
    "displayName": "SL-Career",
    "description": "Career page data for SL"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "Title": {
      "type": "string",
      "required": true
    },
    "Description": {
      "type": "richtext"
    },
    "CurrentOpenings": {
      "type": "component",
      "repeatable": false,
      "component": "shared.current-opening"
    },
    "metaTags": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "shared.seo",
      "repeatable": true,
      "required": true
    },
    "seoSchema": {
      "type": "blocks",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}