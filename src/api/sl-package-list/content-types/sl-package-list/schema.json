{
  "kind": "collectionType",
  "collectionName": "sl_package_lists",
  "info": {
    "singularName": "sl-package-list",
    "pluralName": "sl-package-lists",
    "displayName": "SL-Package-List"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": { "type": "string" },
    "slug": { "type": "uid", "targetField": "title" },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "city": { "type": "string" },
    "country": { "type": "string" },
    "subtitle": { "type": "string" },
    "price": { "type": "decimal" },
    "reviewScore": { "type": "decimal" },
    "reviewCount": { "type": "integer" },
    "url": { "type": "string" },
    "packageType": {
      "type": "enumeration",
      "enum": ["Domestic", "International"]
    },
    "startDate": {
      "type": "date"
    },
    "endDate": {
      "type": "date"
    },
    "regions": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::sl-package-region.sl-package-region",
      "inversedBy": "packages"
    },
    "sl_package_detail": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::sl-package-detail.sl-package-detail",
      "mappedBy": "sl_package_list"
    },
    "metaTags": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": true,
      "required": true,
      "pluginOptions": {
        "i18n": { "localized": true }
      }
    },
    "seoSchema": {
      "type": "blocks",
      "pluginOptions": {
        "i18n": { "localized": true }
      }
    }
  }
}