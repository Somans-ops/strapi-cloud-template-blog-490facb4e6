{
  "kind": "collectionType",
  "collectionName": "sl_contact_uses",
  "info": {
    "singularName": "sl-contact-us",
    "pluralName": "sl-contact-uses",
    "displayName": "SL-Contact-Us",
    "description": "Contact page data for SL"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "Title": {
      "type": "string",
      "required": true
    },
    "Description": {
      "type": "richtext"
    },
    "subTitle": {
      "type": "string",
      "required": true
    },
    "Addresses": {
      "type": "component",
      "repeatable": false,
      "component": "shared.address-details"
    },
    "otherSection": {
      "type": "component",
      "repeatable": true,
      "component": "shared.address-details"
    },
    "metaTags": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "shared.seo",
      "repeatable": true,
      "required": true
    },
    "seoSchema": {
      "type": "blocks",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}